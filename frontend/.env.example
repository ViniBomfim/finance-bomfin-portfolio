# Em desenvolvimento o Vite faz proxy de /api para o backend (vite.config.ts).
# Não é necessário definir VITE_API_URL localmente se usar `npm run dev`.

# Produção local (chamada direta ao backend):
# VITE_API_URL=https://sua-api.exemplo.com
#
# Netlify (your-frontend.example.com): use API_PROXY_TARGET no painel, não VITE_API_URL.
# O build gera proxy /api/* → seu backend (scripts/netlify-build.mjs).
