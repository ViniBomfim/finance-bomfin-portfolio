# --- Desenvolvimento local (SQLite) ---
DATABASE_URL=sqlite:///./finance_manager.db

# --- Supabase / PostgreSQL (produção) ---
# Copie em Supabase → Project Settings → Database → Connection string → URI
# Use Session pooler (5432) ou Transaction pooler (6543) para a API.
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql+psycopg2://postgres.[ref]:[SENHA]@aws-0-[regiao].pooler.supabase.com:6543/postgres

SECRET_KEY=change-me-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Na API com Postgres, aplica migrações Alembic ao subir (padrão: true).
# RUN_MIGRATIONS_ON_STARTUP=true

# Render (ver render.env.example): migrações em scripts/render-start.sh
# RUN_MIGRATIONS_ON_STARTUP=false
# CORS_ORIGINS=https://your-frontend.example.com
