# Render → Web Service → Environment
# Cole no painel ou use Blueprint (render.yaml) + ajuste DATABASE_URL manualmente.

# Obrigatório — Session pooler do Postgres/Supabase (copie URI completa do painel)
# Ex.: postgresql://postgres.YOUR_REF:***@aws-1-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Obrigatório — chave JWT da API (não use a anon key do Supabase)
SECRET_KEY=

# Migrações rodam no scripts/render-start.sh; evita duplicar no lifespan
RUN_MIGRATIONS_ON_STARTUP=false

# Opcional — origem do front (CORS; padrão * se vazio)
CORS_ORIGINS=https://your-frontend.example.com
